rules_version = '2';
// 쉐라폰 보안 규칙 — 1단계(수정본 v2)
// 변경 이유: 카톡/네이버 로그인이 Firebase 인증과 분리돼 있어,
//   규칙에서 "신청의 주인"을 식별할 수 없음 → quotes 수정을 본인제한하면
//   모든 신청 저장(2차 배송/계좌 업데이트)이 막힘.
//   그래서 고객이 쓰는 컬렉션은 읽기/작성/수정을 허용하고,
//   대신 "삭제"와 "내부 데이터(블랙리스트/관리자/채팅)"·"시세/설정 변조"를 차단.
//   고객 정보 '읽기' 완전 잠금은 조회기능을 Cloud Function으로 옮기는 2단계에서.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'dda465@hanmail.net',
          'admin@rejuphone.com',
          'admin@sharaphone.com',
          'guffy321@naver.com',
          'test@admin.com'
        ];
    }

    // 시세표 / 사이트설정: 공개 읽기, 관리자만 수정 (가격·문구 변조 차단)
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // 후기: 공개 읽기 / 작성·수정 허용 / 삭제는 관리자
    match /reviews/{id} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 매입신청: 읽기·작성·수정 허용(고객 신청/2차 저장 유지) / 삭제는 관리자만
    match /quotes/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 외국인 신청: 동일
    match /exchange_applications/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 회원
    // ⚠ 예전엔 update/delete 가 모두 isAdmin() 이었다.
    //    그래서 고객이 '회원 탈퇴'도 '배송지 저장'도 할 수 없었다(권한 오류로 실패).
    //    탈퇴는 문서를 지우지 않고 '탈퇴 표시 + 개인정보 비우기'로 처리하므로
    //    delete 는 계속 관리자만 가능하게 잠가 둔다.
    match /users/{uid} {
      allow read, create: if true;

      // 본인(Firebase 인증 로그인) 또는 관리자
      allow update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid)
                    // 카카오·네이버 가입자는 Firebase 인증 세션이 없어(문서ID가 kakao_... / naver_...)
                    // 본인 확인이 불가능하다.
                    // 이 경우엔 '탈퇴 처리와 배송지'에 해당하는 항목만 바꿀 수 있게 범위를 좁힌다.
                    //
                    // ⚠️ 2026-08-13 수정 — 예전에는 kakao_ 만 있었다.
                    //    네이버 로그인도 같은 구조인데(auth.js 607줄 `naver_${id}`) 패턴에서 빠져 있어
                    //    **네이버 회원 전원이 마이페이지에서 탈퇴가 거부되고 있었다.**
                    //    새 소셜 로그인을 붙일 때마다 여기에 추가해야 한다.
                    || ((uid.matches('kakao_.*') || uid.matches('naver_.*'))
                        && onlySelfServiceFields());

      allow delete: if isAdmin();
    }

    // 고객이 스스로 바꿀 수 있는 항목만 허용 (그 외 필드가 하나라도 섞이면 거부)
    //
    // ⚠️ `nickname` 을 뺐다가 다시 넣었다 (2026-08-13).
    //    네이버·카카오는 이름을 `nickname` 에 저장한다(auth.js 606줄
    //    `getNickName() || getName()`). 여기서 빠져 있으면 탈퇴해도
    //    **이름이 nickname 에 그대로 남는다** — 개인정보 파기가 안 된 것이다.
    function onlySelfServiceFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isWithdrawn', 'withdrawnAt', 'name', 'nickname', 'phone', 'email',
                  'address', 'birthday', 'gender', 'profileImage', 'updatedAt']);
    }

    // 방문/퍼널 통계
    match /analytics/{id} { allow read, write: if true; }

    // 재방문 고객 요약표 (stats/returning_customers)
    // 고객 연락처가 담기므로 관리자만 열람·수정할 수 있다.
    // 서버(Cloud Functions)는 관리자 SDK로 접근하므로 이 규칙의 영향을 받지 않는다.
    match /stats/{id}     { allow read, write: if isAdmin(); }

    // ★ 내부 데이터 완전 차단 (외부인 열람·변경 불가) — 핵심 보안
    match /blacklist/{id} { allow read, write: if isAdmin(); }
    match /admins/{id}    { allow read: if isAdmin(); allow write: if false; }
    match /chats/{id}     { allow read, write: if isAdmin(); }

    // ════════════════════════════════════════════════════════════
    // 직원 앱 (staff.sharaphone.com) — 2026-08 추가
    // 원본: C:\dev\sharaphone-staff\firestore.rules.staff
    // 위쪽 고객 사이트 규칙은 한 줄도 건드리지 않았다. 아래만 추가된 것이다.
    // ════════════════════════════════════════════════════════════

    // ⚠️ 직원 권한은 Firestore 의 staff 문서가 아니라 **커스텀 클레임**으로 판정한다.
    //    문서를 읽어서 판단하면 클라이언트에서 우회된다.
    //    기존 isAdmin()(이메일 목록 방식)과 이름이 겹치지 않게 따로 뒀다.
    function isStaff() {
      return request.auth != null && request.auth.token.team != null;
    }
    function staffTeam() {
      return request.auth.token.team;
    }
    function isStaffAdmin() {
      return isStaff() && staffTeam() == 'admin';
    }

    // 개별 권한 — 소속 팀과 별개로 관리자가 켜준 것.
    // ⚠️ get('perms', []) 로 기본값을 준다. 아직 새 클레임을 못 받은 계정이
    //    오류로 통째로 막히지 않게 하기 위해서다.
    function hasPerm(p) {
      return isStaff() && request.auth.token.get('perms', []).hasAny([p]);
    }

    // 직원 계정 — 직원끼리 이름·팀은 볼 수 있고, 생성·수정은 관리자만
    match /staff/{uid} {
      allow read: if isStaff();
      // 직원 정보·권한 수정은 manageStaff 권한자만.
      // isStaffAdmin() 은 안전장치 — 클레임 갱신이 늦어도 관리자가 잠기지 않게.
      allow write: if isStaffAdmin() || hasPerm('manageStaff');

      // ── 본인의 '비밀번호 바꿈' 표시 — 2026-08-14 추가 ──────────────
      //
      // ⚠️ 위 `allow write` 는 그대로 둔다. 지우면 관리자가 직원 정보를 못 고친다.
      //    Firestore 는 여러 규칙 중 하나라도 허용하면 통과시키므로
      //    update 를 하나 더 얹는 방식이 맞다.
      //
      // ⚠️⚠️ hasOnly(['passwordChangedAt']) 로 바뀐 키를 이 하나로 못 박는다.
      //    **이 줄을 지우면 전 직원이 스스로 team 을 'admin' 으로 바꿀 수 있게 된다.**
      //
      // == request.time 은 값을 서버 시각으로 못 박아 임의 시각(미래 날짜 등)을 막는다.
      // ⭐ 그래서 앱은 반드시 serverTimestamp() 로 써야 한다.
      //    `new Date()` 로 쓰면 밀리초가 안 맞아 **조용히 튕긴다.**
      //    (staffRepo.markPasswordChanged() 주석에 같은 내용이 박혀 있다)
      allow update: if isStaff()
                    && uid == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['passwordChangedAt'])
                    && request.resource.data.passwordChangedAt == request.time;
    }

    // 근태 설정 (휴게시간 공제 규칙)
    // ⚠️ 위 settings 컬렉션에 두지 않은 이유: 거기는 `allow read: if true` 라
    //    읽기가 완전 공개다. 규칙은 하나라도 허용하면 통과하므로 하위에 엄격한
    //    규칙을 덧붙여도 막을 수 없다. 그래서 직원 전용 컬렉션을 따로 쓴다.
    match /staff_settings/{id} {
      allow read: if isStaff();
      allow write: if isStaffAdmin() || hasPerm('manageSettings');
    }

    // 공지·게시판 (2026-08 추가)
    match /posts/{postId} {
      allow read: if isStaff();

      // 작성자를 자기 자신으로만 쓸 수 있다 (남의 이름으로 글 못 씀)
      allow create: if isStaff()
                    && request.resource.data.authorUid == request.auth.uid
                    && (request.resource.data.category != 'notice' || isStaffAdmin());

      allow delete: if isStaffAdmin() || resource.data.authorUid == request.auth.uid;

      allow update: if
        // ① 작성자 본인 또는 관리자의 정상 수정
        (
          (isStaffAdmin() || resource.data.authorUid == request.auth.uid)
          && request.resource.data.authorUid == resource.data.authorUid
          && (request.resource.data.category != 'notice' || isStaffAdmin())
        )
        // ② 읽음 표시 — 누구나 **자기 uid 하나만** 추가할 수 있다
        || (
          isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasOnly(
               resource.data.readBy.concat([request.auth.uid]))
        )
        // ③ 댓글 수 — 정확히 1 늘거나 1 줄어드는 것만 허용 (임의 값 못 씀)
        || (
          isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && (
            request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount == resource.data.commentCount - 1
          )
        );

      // 댓글 — 수정은 없다. 고칠 일이 있으면 지우고 다시 쓴다
      match /comments/{commentId} {
        allow read: if isStaff();
        allow create: if isStaff()
                      && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isStaffAdmin() || resource.data.authorUid == request.auth.uid;
      }
    }

    // 근태 기록 — 문서 ID 는 `{YYYY-MM}_{uid}`
    match /attendance/{docId} {
      // 본인 기록 또는 관리자
      // ⚠️ 전제: uid 에 밑줄(_)이 없다. Firebase Auth uid 는 영숫자 28자라 안전하다.
      //    밑줄이 들어가는 uid(고객 쪽 `kakao_...` 형태)를 직원 계정에 쓰기 시작하면
      //    이 규칙이 깨진다. 그때는 문서에 uid 필드를 두고 그걸 비교하도록 바꾼다.
      allow read: if isStaffAdmin()
                  || hasPerm('editAttendance')
                  || (isStaff() && docId.split('_')[1] == request.auth.uid);

      // ★ 브라우저에서 직접 쓰지 못하게 막는다.
      //   출퇴근 시각을 브라우저가 찍으면 폰 시계를 바꿔 조작할 수 있다.
      //   기록은 Cloud Functions(관리자 SDK)가 서버 시각으로 쓴다.
      allow create, delete: if false;

      // 관리자의 예외 처리(반차·외근 등)만 허용. 수정 이력을 반드시 남기게 강제한다.
      // ⚠️ get('edits', []) 로 기본값을 준다 — 필드가 없는 문서에서 오류가 나면
      //    관리자 수정이 통째로 막힌다.
      // ⚠️ 괄호 위치 주의. `&&` 가 `||` 보다 먼저 묶이므로
      //      isStaffAdmin() || hasPerm(...) && 이력검사
      //    라고 쓰면 관리자는 이력을 안 남기고도 근태를 고칠 수 있게 된다.
      //    근로시간 기록은 법정 3년 보관이라 이력이 빠지면 안 된다.
      //    → 권한 부분만 괄호로 묶고, 이력 검사는 누구에게나 적용한다.
      allow update: if (isStaffAdmin() || hasPerm('editAttendance'))
                    && request.resource.data.get('edits', []).size()
                       > resource.data.get('edits', []).size();
    }

    // 재방문 요약표 — 직원 앱에서 뱃지를 그리려면 읽을 수 있어야 한다.
    //
    // ⚠️ 위 77줄의 `match /stats/{id} { allow read, write: if isAdmin(); }` 은 그대로 둔다.
    //    Firestore 는 여러 규칙 중 **하나라도 허용하면 통과**하므로,
    //    같은 경로에 규칙을 하나 더 두면 기존 동작을 안 건드리고 열 수 있다.
    //    (기존 isAdmin() 은 이메일 목록 방식이라 직원 앱 계정이 들어 있지 않다)
    //
    // ⚠️ 쓰기는 절대 열지 않는다. 이 문서는 Cloud Functions 가 관리자 SDK 로 갱신하므로
    //    이 규칙의 영향을 받지 않는다. 브라우저 쓰기를 열면 직원 한 명의 실수로
    //    전체 집계가 날아가고 되돌릴 방법이 없다.
    match /stats/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // 재고 (5단계 · 직원 앱 전용) — 2026-08-20 추가
    //
    // ⚠️ 고객 사이트는 이 컬렉션을 보지 않는다. 직원 앱만 읽고 쓴다.
    // ⚠️ 등록한 사람을 자기 자신으로만 쓸 수 있다 — 남의 이름으로 등록 못 한다.
    //    검수한 사람이 입금까지 하는 구조라 이력이 유일한 사후 추적 근거다.
    // ★ 물리 삭제를 막는다. 등록취소는 isDeleted 플래그로 한다 —
    //   지우면 왜 없어졌는지 영영 못 찾는다 (quotes 삭제와 같은 원칙).
    match /inventory/{id} {
      allow read: if isStaffAdmin() || hasPerm('stock') || hasPerm('viewAnalytics');

      allow create: if (isStaffAdmin() || hasPerm('stock'))
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isStaffAdmin() || hasPerm('stock');

      allow delete: if false;
    }

    // 그 외 모든 경로 차단
    match /{document=**}  { allow read, write: if false; }
  }
}
