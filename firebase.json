{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "backup_files/**",
      "firestore.rules",
      "storage.rules",
      "*.bak*",
      "script.mjs",
      "script_live.js",
      "missing.js",
      ".agent/**",
      "*.bat",
      "*.py",
      "tmp_*.txt",
      "deploy_log*.txt",
      "output*.txt",
      "admin_*.txt",
      "analysis_report.txt",
      "console_output.txt",
      "fb_help.txt",
      "fetch_func.txt",
      "parens.txt",
      "sheet_data_inspect.txt",
      "temp_view.txt",
      "tree.txt",
      "verify_output.txt",
      "google-sheets-key.json",
      "serviceAccountKey.json",
      "package.json",
      "package-lock.json",
      "firestore.indexes.json",
      "test.js",
      "test_*.js",
      "check_*.js",
      "upload_*.js",
      "find_*.js",
      "seed_*.js",
      "recover*.js",
      "repair*.js"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}