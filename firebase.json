{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".agent/**",
      "*.bat",
      "*.py",
      "*.txt",
      "google-sheets-key.json",
      "serviceAccountKey.json",
      "package.json",
      "package-lock.json",
      "firestore.indexes.json",
      "test.js",
      "test_*.js",
      "check_*.js",
      "upload_*.js",
      "find_*.js",
      "seed_*.js",
      "recover*.js",
      "repair*.js"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}